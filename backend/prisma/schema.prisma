generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  OPEN
  CLOSED
}

enum SpinStatus {
  WAITING
  RUNNING
  COMPLETED
  ABORTED
}

enum SpinParticipantStatus {
  ACTIVE
  ELIMINATED
  WINNER
  LEFT
}

model User {
  id        String   @id @default(cuid())
  displayName String
  createdAt DateTime @default(now())

  ownedRooms    Room[]           @relation("RoomOwner")
  memberships   RoomMember[]
  drafts        Draft[]
  spinParts     SpinParticipant[]
}

model Room {
  id        String     @id @default(cuid())
  name      String
  status    RoomStatus @default(OPEN)
  ownerId   String
  owner     User       @relation("RoomOwner", fields: [ownerId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members RoomMember[]
  drafts  Draft[]
  spins   Spin[]

  @@index([ownerId])
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Draft {
  id         String   @id @default(cuid())
  roomId     String?
  userId     String
  name       String
  createdAt  DateTime @default(now())
  durationMs Int
  filePath   String
  effect     String
  shared     Boolean  @default(false)

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomId])
}

model Spin {
  id          String     @id @default(cuid())
  roomId      String
  status      SpinStatus @default(WAITING)
  startedAt   DateTime?
  completedAt DateTime?
  winnerId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  room         Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants SpinParticipant[]
  events       SpinEvent[]

  @@index([roomId, status])
}

model SpinParticipant {
  id             String                 @id @default(cuid())
  spinId         String
  userId         String
  status         SpinParticipantStatus  @default(ACTIVE)
  eliminationOrder Int?
  eliminatedAt   DateTime?

  spin Spin @relation(fields: [spinId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spinId, userId])
}

model SpinEvent {
  id        String   @id @default(cuid())
  spinId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  spin Spin @relation(fields: [spinId], references: [id], onDelete: Cascade)

  @@index([spinId, createdAt])
}
