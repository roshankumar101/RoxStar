{
  "name": "roxstar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ROXSTAR room, realtime, and spin service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:check": "node -e \"import('mongoose').then(({default: mongoose}) => mongoose.connect(process.env.MONGODB_URI ?? 'mongodb://127.0.0.1:27017/roxstar').then(() => mongoose.disconnect()))\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
